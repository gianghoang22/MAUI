<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Controls.VocabularyFlashcard">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Style="{StaticResource Card}" Padding="24">
                <VerticalStackLayout Spacing="20">
                    <Label Text="{TemplateBinding Prompt}" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="QuestionText" />
                    <Label Text="{TemplateBinding Answer}" IsVisible="{TemplateBinding IsRevealed}" FontSize="24" HorizontalTextAlignment="Center" AutomationId="AnswerText" />
                </VerticalStackLayout>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
