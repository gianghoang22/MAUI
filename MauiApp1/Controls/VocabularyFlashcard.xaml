<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Controls.VocabularyFlashcard">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border x:Name="CardSurface" Style="{StaticResource Card}" Padding="32" MinimumHeightRequest="230">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
                    <Label Text="{TemplateBinding FaceCaption}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                    <Label Grid.Row="1" Text="{TemplateBinding FaceText}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           VerticalOptions="Center" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" AutomationId="QuestionText" />
                    <Label Grid.Row="2" Text="{TemplateBinding Answer}" IsVisible="{TemplateBinding ShowSecondaryAnswer}" FontSize="22"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap" AutomationId="AnswerText" />
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
