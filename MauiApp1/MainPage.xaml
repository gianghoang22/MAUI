<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls" xmlns:vm="clr-namespace:MauiApp1.ViewModels" x:Class="MauiApp1.MainPage" Shell.NavBarIsVisible="False" x:DataType="vm:LibraryViewModel" Title="VocabMate">
    <controls:CollectionWorkspace>
        <controls:CollectionWorkspace.Form>
            <VerticalStackLayout Spacing="20" Padding="0,0,0,20">
                <Label Text="VOCABMATE" FontAttributes="Bold" CharacterSpacing="3" TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
                <Label Text="{DynamicResource L10n.VHomeHeading}" Style="{StaticResource PageHeading}" />
                <Label Text="{DynamicResource L10n.VHomeIntro}" Style="{StaticResource MutedText}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Summary}" Style="{StaticResource SectionHeading}" />
                        <Label Text="{DynamicResource L10n.VLocalClassesHint}" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="{DynamicResource L10n.VContinueLearning}" Command="{Binding ResumeCommand}"
                        IsVisible="{Binding CanResume}" IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource PrimaryButton}" AutomationId="ResumeLearningButton" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{DynamicResource L10n.VAddClass}" Style="{StaticResource SectionHeading}" />
                        <Entry IsReadOnly="{Binding IsBusy}" Text="{Binding NewName}" MaxLength="80" Placeholder="{DynamicResource L10n.VClassPlaceholder}" AutomationId="NewClassName" ReturnType="Done" ReturnCommand="{Binding AddCommand}" />
                        <Button Text="{DynamicResource L10n.VAddClass}" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" AutomationId="AddClassButton" />
                    </VerticalStackLayout>
                </Border>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </controls:CollectionWorkspace.Form>
        <controls:CollectionWorkspace.ListHeading>
            <Label Text="{DynamicResource L10n.VYourClasses}" Style="{StaticResource SectionHeading}" VerticalOptions="Center" Margin="0,0,0,6" />
        </controls:CollectionWorkspace.ListHeading>
        <controls:CollectionWorkspace.Collection>
            <CollectionView ItemsSource="{Binding Classes}" ItemTemplate="{StaticResource NamedRowTemplate}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView><Label Text="{DynamicResource L10n.VClassesEmpty}" Style="{StaticResource MutedText}" /></CollectionView.EmptyView>
            </CollectionView>
        </controls:CollectionWorkspace.Collection>
    </controls:CollectionWorkspace>
</ContentPage>
