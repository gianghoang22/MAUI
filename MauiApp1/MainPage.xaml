<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls" xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.MainPage" Shell.NavBarIsVisible="False" x:DataType="vm:LibraryViewModel" Title="{DynamicResource L10n.VLibrary}">
    <Grid x:Name="DashboardLayout" RowDefinitions="Auto,*" Padding="20" RowSpacing="20" MaximumWidthRequest="1120" HorizontalOptions="Fill" SizeChanged="OnDashboardSizeChanged">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Border Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}">
                <SearchBar Text="{Binding Search}" Placeholder="{DynamicResource L10n.VSearchClasses}" SemanticProperties.Description="{DynamicResource L10n.VSearchClasses}" AutomationId="SearchClasses" />
            </Border>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" WidthRequest="28" />
        </Grid>
        <controls:AdaptiveCollectionView Grid.Row="1" Source="{Binding Classes}" Compact="True" TileTemplate="{StaticResource CompactNamedRowTemplate}" AutomationId="LibraryClasses">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Padding="0,0,0,16">
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                        <VerticalStackLayout Spacing="4" Margin="0,0,16,8">
                            <Label Text="{DynamicResource L10n.VLibrary}" Style="{StaticResource PageHeading}" FontSize="28" />
                            <Label Text="{Binding Summary}" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Button Text="{Binding CreateActionText}" Command="{Binding ToggleCreateCommand}" Style="{StaticResource PrimaryButton}" AutomationId="ToggleCreateClassButton" />
                    </FlexLayout>
                    <Border Style="{StaticResource InsetCard}" IsVisible="{Binding ShowCreate}" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{DynamicResource L10n.VClassName}" FontFamily="OpenSansSemibold" />
                            <Label Text="{DynamicResource L10n.VCreateClassHint}" Style="{StaticResource MutedText}" />
                            <Entry Text="{Binding NewName}" MaxLength="80" Placeholder="{DynamicResource L10n.VClassPlaceholder}" SemanticProperties.Description="{DynamicResource L10n.VClassName}" AutomationId="NewClassName" ReturnType="Done" ReturnCommand="{Binding AddCommand}" />
                            <Button Text="{DynamicResource L10n.VAddClass}" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" AutomationId="AddClassButton" />
                        </VerticalStackLayout>
                    </Border>
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                        <Label Text="{Binding SearchSummary}" Style="{StaticResource MutedText}" Margin="0,8,12,8" />
                        <Button Text="{DynamicResource L10n.VClearSearch}" Command="{Binding ClearSearchCommand}" IsVisible="{Binding HasSearch}" Style="{StaticResource QuietButton}" AutomationId="ClearClassSearch" />
                    </FlexLayout>
                    <Border Style="{StaticResource InsetCard}" Padding="20" IsVisible="{Binding IsSearchEmpty}" AutomationId="LibraryEmptyState">
                        <Label Text="{Binding EmptyMessage}" Style="{StaticResource MutedText}" />
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>
        </controls:AdaptiveCollectionView>
    </Grid>
</ContentPage>
