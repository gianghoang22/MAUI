<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:vm="clr-namespace:MauiApp1.ViewModels">
    <Color x:Key="PageBackgroundLight">#F6F4EF</Color>
    <Color x:Key="PageBackgroundDark">#181A18</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#232622</Color>
    <Color x:Key="FieldLight">#EEECE6</Color>
    <Color x:Key="FieldDark">#2C302A</Color>
    <Color x:Key="OutlineLight">#DAD7CE</Color>
    <Color x:Key="OutlineDark">#44483E</Color>
    <Color x:Key="TextPrimaryLight">#252A25</Color>
    <Color x:Key="TextPrimaryDark">#F3F1EA</Color>
    <Color x:Key="TextMutedLight">#616359</Color>
    <Color x:Key="TextMutedDark">#BDBFB2</Color>
    <Color x:Key="AccentSubtleLight">#F1EDE4</Color>
    <Color x:Key="AccentSubtleDark">#30332B</Color>
    <Color x:Key="AccentSoftLight">#E8E0CF</Color>
    <Color x:Key="AccentSoftDark">#414335</Color>
    <Color x:Key="AccentTextLight">#74603B</Color>
    <Color x:Key="AccentTextDark">#D9C398</Color>
    <Color x:Key="AccentOutlineLight">#95805A</Color>
    <Color x:Key="AccentOutlineDark">#B8A077</Color>
    <Color x:Key="AccentSelectedLight">#303A30</Color>
    <Color x:Key="AccentSelectedDark">#D9C398</Color>
    <Color x:Key="HeroBackground">#29332C</Color>
    <Color x:Key="HeroMuted">#DDD6C5</Color>
    <Color x:Key="DangerTextLight">#9C3631</Color>
    <Color x:Key="DangerTextDark">#FFB4AB</Color>
    <Color x:Key="DangerSurfaceLight">#F9EDE9</Color>
    <Color x:Key="DangerSurfaceDark">#492C29</Color>
    <OnPlatform x:Key="PagePadding" x:TypeArguments="Thickness" Default="20,20,20,28"><On Platform="WinUI" Value="32,28,32,32" /></OnPlatform>
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True"><Setter Property="SafeAreaEdges" Value="Container" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" /></Style>
    <Style TargetType="ScrollView"><Setter Property="SafeAreaEdges" Value="SoftInput" /></Style>
    <Style x:Key="BodyText" TargetType="Label"><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="FontSize" Value="15" /><Setter Property="LineBreakMode" Value="WordWrap" /></Style>
    <Style TargetType="Label" BasedOn="{StaticResource BodyText}" />
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSubtleLight}, Dark={StaticResource AccentSubtleDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
        <Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="20,13" />
        <Setter Property="FontSize" Value="14" /><Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="BorderWidth" Value="1" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Focused"><VisualState.Setters><Setter Property="BorderWidth" Value="3" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource AccentOutlineLight}, Dark={StaticResource AccentOutlineDark}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="Opacity" Value="0.85" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="Opacity" Value="0.7" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSelectedLight}, Dark={StaticResource AccentSelectedDark}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PageBackgroundDark}}" /><Setter Property="BorderColor" Value="Transparent" /></Style>
    <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="#F3EBDD" /><Setter Property="TextColor" Value="{StaticResource HeroBackground}" /><Setter Property="BorderColor" Value="{StaticResource HeroMuted}" /></Style>
    <Style x:Key="Eyebrow" TargetType="Label" BasedOn="{StaticResource BodyText}"><Setter Property="FontSize" Value="11" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="CharacterSpacing" Value="2" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /></Style>
    <Style x:Key="StatNumber" TargetType="Label" BasedOn="{StaticResource BodyText}"><Setter Property="FontSize" Value="30" /><Setter Property="FontFamily" Value="OpenSansSemibold" /></Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" /><Setter Property="BorderWidth" Value="1" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" /></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSurfaceLight}, Dark={StaticResource DangerSurfaceDark}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerTextLight}, Dark={StaticResource DangerTextDark}}" /></Style>
    <Style TargetType="Entry" ApplyToDerivedTypes="True"><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="FontSize" Value="16" /></Style>
    <Style TargetType="Picker"><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="FontSize" Value="15" /></Style>
    <Style TargetType="Editor"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="FontSize" Value="16" /></Style>
    <Style TargetType="SearchBar"><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" /><Setter Property="CancelButtonColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /><Setter Property="FontSize" Value="16" /></Style>
    <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /></Style>
    <Style TargetType="ProgressBar"><Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource AccentSelectedLight}, Dark={StaticResource AccentTextDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSubtleLight}, Dark={StaticResource AccentSubtleDark}}" /><Setter Property="HeightRequest" Value="6" /></Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding">
            <OnPlatform x:TypeArguments="Thickness" Default="20">
                <On Platform="WinUI" Value="24" />
            </OnPlatform>
        </Setter>
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>
    <Style x:Key="InsetCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSubtleLight}, Dark={StaticResource AccentSubtleDark}}" /></Style>
    <Style x:Key="PageHeading" TargetType="Label" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize">
            <OnPlatform x:TypeArguments="x:Double" Default="30">
                <On Platform="WinUI" Value="38" />
            </OnPlatform>
        </Setter>
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="Label" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize">
            <OnPlatform x:TypeArguments="x:Double" Default="17">
                <On Platform="WinUI" Value="19" />
            </OnPlatform>
        </Setter>
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="MutedText" TargetType="Label" BasedOn="{StaticResource BodyText}"><Setter Property="FontSize" Value="14" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /></Style>
    <Style x:Key="ErrorText" TargetType="Label" BasedOn="{StaticResource MutedText}"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerTextLight}, Dark={StaticResource DangerTextDark}}" /></Style>
    <Color x:Key="DialogBackdropLight">#80212520</Color>
    <Color x:Key="DialogBackdropDark">#B3101210</Color>
    <Style x:Key="DialogSurface" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="24" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>
    <Style x:Key="DialogActionButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Focused"><VisualState.Setters><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /><Setter Property="BorderWidth" Value="2" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource AccentOutlineLight}, Dark={StaticResource AccentOutlineDark}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="DialogCancelButton" TargetType="Button" BasedOn="{StaticResource DialogActionButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>
    <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DialogActionButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSurfaceLight}, Dark={StaticResource DangerSurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerTextLight}, Dark={StaticResource DangerTextDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource DangerTextLight}, Dark={StaticResource DangerTextDark}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Focused"><VisualState.Setters><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource DangerTextLight}, Dark={StaticResource DangerTextDark}}" /><Setter Property="BorderWidth" Value="2" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BorderWidth" Value="2" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource DangerTextLight}, Dark={StaticResource DangerTextDark}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="ActionMenuButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Text" Value="&#x22EF;" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="SemanticProperties.Description" Value="{DynamicResource L10n.VActions}" />
        <Setter Property="ToolTipProperties.Text" Value="{DynamicResource L10n.VActions}" />
    </Style>
    <Style x:Key="CardOpenButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSubtleLight}, Dark={StaticResource AccentSubtleDark}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Focused"><VisualState.Setters><Setter Property="BorderWidth" Value="2" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled" />
            </VisualStateGroup></VisualStateGroupList>
        </Setter>
    </Style>
    <DataTemplate x:Key="NamedRowTemplate" x:DataType="vm:NamedRow">
        <Border Style="{StaticResource Card}" Padding="8" MinimumHeightRequest="164">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Button Grid.RowSpan="3" Command="{Binding OpenCommand}" Style="{StaticResource CardOpenButton}"
                            SemanticProperties.Description="{Binding Name}" ToolTipProperties.Text="{DynamicResource L10n.Open}" AutomationId="NamedRowOpenButton" />
                    <Border Margin="12,12,0,0" Padding="10" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSubtleLight}, Dark={StaticResource AccentSubtleDark}}" HorizontalOptions="Start" InputTransparent="True">
                        <Image Source="study_stack.png" WidthRequest="24" HeightRequest="24" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Label Grid.Row="1" Text="{Binding Name}" Style="{StaticResource SectionHeading}" Margin="12,0,8,0" InputTransparent="True" />
                    <Label Grid.Row="2" Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="12,0,12,12" InputTransparent="True" />
                </Grid>
                <Button Grid.Column="1" Command="{Binding MenuCommand}" IsVisible="{Binding HasMenu}" Margin="4,8"
                        Style="{StaticResource ActionMenuButton}" AutomationId="NamedRowActionsButton" />
            </Grid>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="VocabularyCardTemplate" x:DataType="vm:VocabularyCardRow">
        <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8"><Label Text="{Binding English}" Style="{StaticResource SectionHeading}" /><Label Grid.Row="1" Text="{Binding Vietnamese}" /></Grid>
            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Button Text="{Binding StarText}" Command="{Binding StarCommand}" Style="{StaticResource QuietButton}" FontSize="22" Padding="10,0"
                        SemanticProperties.Description="{Binding StarDescription}" ToolTipProperties.Text="{Binding StarDescription}" AutomationId="CardStarButton" />
                <Button Command="{Binding MenuCommand}" Style="{StaticResource ActionMenuButton}" AutomationId="CardActionsButton" />
            </VerticalStackLayout>
        </Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="ChoiceTemplate" x:DataType="vm:ChoiceRow"><Button Text="{Binding Text}" Command="{Binding SelectCommand}" MinimumHeightRequest="58" /></DataTemplate>
    <DataTemplate x:Key="MatchTemplate" x:DataType="vm:MatchRow">
        <Button Text="{Binding Text}" Command="{Binding SelectCommand}" IsEnabled="{Binding IsAvailable}" MinimumHeightRequest="70" BorderWidth="1" BorderColor="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource AccentOutlineLight}, Dark={StaticResource AccentOutlineDark}}" /></DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding IsMatched}" Value="True"><Setter Property="Opacity" Value="0.35" /></DataTrigger>
            </Button.Triggers>
        </Button>
    </DataTemplate>
</ResourceDictionary>
