<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:vm="clr-namespace:MauiApp1.ViewModels">
    <Color x:Key="PageBackgroundLight">#FAFAFA</Color>
    <Color x:Key="PageBackgroundDark">#1E293B</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#334155</Color>
    <Color x:Key="FieldLight">#F1F5F9</Color>
    <Color x:Key="FieldDark">#0F172A</Color>
    <Color x:Key="OutlineLight">#E2E8F0</Color>
    <Color x:Key="OutlineDark">#475569</Color>
    <Color x:Key="TextPrimaryLight">#334155</Color>
    <Color x:Key="TextPrimaryDark">#F8FAFC</Color>
    <Color x:Key="TextMutedLight">#64748B</Color>
    <Color x:Key="TextMutedDark">#94A3B8</Color>
    <Color x:Key="AccentSubtleLight">#E0F2FE</Color>
    <Color x:Key="AccentSubtleDark">#0F172A</Color>
    <Color x:Key="AccentSoftLight">#BAE6FD</Color>
    <Color x:Key="AccentSoftDark">#1E293B</Color>
    <Color x:Key="AccentTextLight">#0EA5E9</Color>
    <Color x:Key="AccentTextDark">#38BDF8</Color>
    <Color x:Key="AccentOutlineLight">#7DD3FC</Color>
    <Color x:Key="AccentOutlineDark">#0284C7</Color>
    <Color x:Key="AccentSelectedLight">#38BDF8</Color>
    <Color x:Key="AccentSelectedDark">#0369A1</Color>
    <OnPlatform x:Key="PagePadding" x:TypeArguments="Thickness" Default="20"><On Platform="WinUI" Value="28" /></OnPlatform>
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" /></Style>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="FontSize" Value="16" /><Setter Property="LineBreakMode" Value="WordWrap" /></Style>
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSubtleLight}, Dark={StaticResource AccentSubtleDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
        <Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="18,12" />
        <Setter Property="FontSize" Value="15" /><Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="BorderWidth" Value="1" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Focused" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /></Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" /><Setter Property="BorderWidth" Value="1" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" /></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FEE2E2, Dark=#7F1D1D}" /><Setter Property="TextColor" Value="{AppThemeBinding Light=#EF4444, Dark=#FCA5A5}" /></Style>
    <Style TargetType="Entry" ApplyToDerivedTypes="True"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" /><Setter Property="MinimumHeightRequest" Value="46" /><Setter Property="FontSize" Value="16" /></Style>
    <Style TargetType="Picker"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" /><Setter Property="MinimumHeightRequest" Value="46" /><Setter Property="FontSize" Value="15" /></Style>
    <Style TargetType="Editor"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" /><Setter Property="MinimumHeightRequest" Value="46" /><Setter Property="FontSize" Value="16" /></Style>
    <Style TargetType="SearchBar"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" /><Setter Property="CancelButtonColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /><Setter Property="FontSize" Value="16" /></Style>
    <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /></Style>
    <Style TargetType="ProgressBar"><Setter Property="ProgressColor" Value="{AppThemeBinding Light=#4ADE80, Dark=#22C55E}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSubtleLight}, Dark={StaticResource AccentSubtleDark}}" /></Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="20" /><Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>
    <Style x:Key="PageHeading" TargetType="Label"><Setter Property="FontSize" Value="26" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="SemanticProperties.HeadingLevel" Value="Level1" /></Style>
    <Style x:Key="SectionHeading" TargetType="Label"><Setter Property="FontSize" Value="19" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" /><Setter Property="SemanticProperties.HeadingLevel" Value="Level2" /></Style>
    <Style x:Key="MutedText" TargetType="Label"><Setter Property="FontSize" Value="14" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" /><Setter Property="LineBreakMode" Value="WordWrap" /></Style>
    <DataTemplate x:Key="NamedRowTemplate" x:DataType="vm:NamedRow">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8"><Label Text="{Binding Name}" Style="{StaticResource SectionHeading}" /><Label Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource MutedText}" /></Grid>
            <Button Grid.Column="1" Text="{DynamicResource L10n.Open}" Command="{Binding OpenCommand}" VerticalOptions="Center" SemanticProperties.Description="{Binding Name}" />
        </Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="VocabularyCardTemplate" x:DataType="vm:VocabularyCardRow">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8"><Label Text="{Binding English}" Style="{StaticResource SectionHeading}" /><Label Grid.Row="1" Text="{Binding Vietnamese}" /></Grid>
            <VerticalStackLayout Grid.Column="1" Spacing="10"><Button Text="{Binding StarText}" Command="{Binding StarCommand}" Style="{StaticResource QuietButton}" SemanticProperties.Description="{Binding StarDescription}" /><Button Text="{DynamicResource L10n.VEdit}" Command="{Binding OpenCommand}" SemanticProperties.Description="{Binding English}" /></VerticalStackLayout>
        </Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="ChoiceTemplate" x:DataType="vm:ChoiceRow"><Button Text="{Binding Text}" Command="{Binding SelectCommand}" MinimumHeightRequest="58" /></DataTemplate>
    <DataTemplate x:Key="MatchTemplate" x:DataType="vm:MatchRow">
        <Button Text="{Binding Text}" Command="{Binding SelectCommand}" IsEnabled="{Binding IsAvailable}" MinimumHeightRequest="70" BorderWidth="1" BorderColor="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource AccentOutlineLight}, Dark={StaticResource AccentOutlineDark}}" /></DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding IsMatched}" Value="True"><Setter Property="Opacity" Value="0.35" /></DataTrigger>
            </Button.Triggers>
        </Button>
    </DataTemplate>
</ResourceDictionary>
