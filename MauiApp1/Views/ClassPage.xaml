<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls" xmlns:vm="clr-namespace:MauiApp1.ViewModels" x:Class="MauiApp1.Views.ClassPage" Shell.NavBarIsVisible="False" x:DataType="vm:ClassViewModel" Title="{DynamicResource L10n.VClass}">
    <controls:CollectionWorkspace>
        <controls:CollectionWorkspace.Form>
            <VerticalStackLayout Spacing="20" Padding="0,0,0,20">
                <Button Text="{DynamicResource L10n.VBack}" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" AutomationId="PageBackButton" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{Binding Name}" Style="{StaticResource PageHeading}" />
                    <Button Grid.Column="1" Command="{Binding MenuCommand}" Style="{StaticResource ActionMenuButton}" IsEnabled="{Binding IsNotBusy}" AutomationId="ClassActionsButton" />
                </Grid>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{DynamicResource L10n.VClassName}" FontAttributes="Bold" />
                        <Entry IsReadOnly="{Binding IsBusy}" Text="{Binding Name}" MaxLength="80" ReturnType="Done" ReturnCommand="{Binding SaveCommand}" SemanticProperties.Description="{DynamicResource L10n.VClassName}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{DynamicResource L10n.VAddDeck}" Style="{StaticResource SectionHeading}" />
                        <Entry IsReadOnly="{Binding IsBusy}" Text="{Binding NewDeckName}" MaxLength="80" Placeholder="{DynamicResource L10n.VDeckPlaceholder}" AutomationId="NewDeckName" ReturnType="Done" ReturnCommand="{Binding AddCommand}" />
                        <Button Text="{DynamicResource L10n.VAddDeck}" Command="{Binding AddCommand}" IsEnabled="{Binding CanAddDeck}" Style="{StaticResource PrimaryButton}" AutomationId="AddDeckButton" />
                    </VerticalStackLayout>
                </Border>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </controls:CollectionWorkspace.Form>
        <controls:CollectionWorkspace.ListHeading>
            <VerticalStackLayout Spacing="6">
                <Label Text="{DynamicResource L10n.VStudySets}" Style="{StaticResource SectionHeading}" />
                <Label Text="{DynamicResource L10n.VStudySetsHint}" Style="{StaticResource MutedText}" />
                <SearchBar Text="{Binding Search}" Placeholder="{DynamicResource L10n.VSearchDecks}" SemanticProperties.Description="{DynamicResource L10n.VSearchDecks}" AutomationId="SearchDecks" />
                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                    <Label Text="{Binding SearchSummary}" Style="{StaticResource MutedText}" Margin="0,8,12,8" />
                    <Button Text="{DynamicResource L10n.VClearSearch}" Command="{Binding ClearSearchCommand}" IsVisible="{Binding HasSearch}" Style="{StaticResource QuietButton}" AutomationId="ClearDeckSearch" />
                </FlexLayout>
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsSearchEmpty}" AutomationId="ClassEmptyState" Margin="0,0,0,16" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding EmptyMessage}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </controls:CollectionWorkspace.ListHeading>
        <controls:CollectionWorkspace.Collection>
            <controls:AdaptiveCollectionView Source="{Binding Decks}" TileTemplate="{StaticResource NamedRowTemplate}">
            </controls:AdaptiveCollectionView>
        </controls:CollectionWorkspace.Collection>
    </controls:CollectionWorkspace>
</ContentPage>
