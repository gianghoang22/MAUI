<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels" x:Class="MauiApp1.Views.ClassPage" x:DataType="vm:ClassViewModel" Title="{DynamicResource L10n.VClass}">
    <ContentPage.ToolbarItems><ToolbarItem Text="{DynamicResource L10n.Refresh}" Command="{Binding RefreshCommand}" /></ContentPage.ToolbarItems>
    <Grid Padding="20" MaximumWidthRequest="900">
        <CollectionView ItemsSource="{Binding Decks}" ItemTemplate="{StaticResource NamedRowTemplate}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Padding="0,0,0,20" IsEnabled="{Binding IsNotBusy}">
                    <Label Text="{Binding Name}" Style="{StaticResource PageHeading}" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{DynamicResource L10n.VClassName}" FontAttributes="Bold" />
                            <Entry Text="{Binding Name}" MaxLength="80" SemanticProperties.Description="{DynamicResource L10n.VClassName}" />
                            <Button Text="{DynamicResource L10n.VSave}" Command="{Binding SaveCommand}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{DynamicResource L10n.VAddDeck}" Style="{StaticResource SectionHeading}" />
                            <Entry Text="{Binding NewDeckName}" MaxLength="80" Placeholder="{DynamicResource L10n.VDeckPlaceholder}" AutomationId="NewDeckName" />
                            <Button Text="{DynamicResource L10n.VAddDeck}" Command="{Binding AddCommand}" AutomationId="AddDeckButton" />
                        </VerticalStackLayout>
                    </Border>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView><Label Text="{DynamicResource L10n.VDecksEmpty}" Style="{StaticResource MutedText}" /></CollectionView.EmptyView>
            <CollectionView.Footer><Button Text="{DynamicResource L10n.VDeleteClass}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,20" /></CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
