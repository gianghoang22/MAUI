<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels" x:Class="MauiApp1.Views.HistoryPage" x:DataType="vm:HistoryViewModel" Title="{DynamicResource L10n.VHistory}">
    <ContentPage.ToolbarItems><ToolbarItem Text="{DynamicResource L10n.Refresh}" Command="{Binding RefreshCommand}" /></ContentPage.ToolbarItems>
    <Grid Padding="20" MaximumWidthRequest="900">
        <CollectionView ItemsSource="{Binding Results}" SelectionMode="None">
            <CollectionView.Header><Label Text="{DynamicResource L10n.VHistoryHeading}" Style="{StaticResource PageHeading}" Margin="0,0,0,20" /></CollectionView.Header>
            <CollectionView.EmptyView><Label Text="{DynamicResource L10n.VHistoryEmpty}" Style="{StaticResource MutedText}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ResultRow">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding Name}" Style="{StaticResource SectionHeading}" />
                            <Label Text="{Binding Summary}" />
                            <Label Text="{Binding Details}" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding WrongAnswers}" IsVisible="{Binding CanRetry}" />
                            <Button Text="{DynamicResource L10n.VRetryWrong}" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
