<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls" xmlns:vm="clr-namespace:MauiApp1.ViewModels" x:Class="MauiApp1.Views.ImportPage" Shell.NavBarIsVisible="False" x:DataType="vm:ImportViewModel" Title="{DynamicResource L10n.VImportExcel}">
    <controls:CollectionWorkspace>
        <controls:CollectionWorkspace.Form>
            <VerticalStackLayout Spacing="20" Padding="0,0,0,20" IsEnabled="{Binding IsNotBusy}">
                <Button Text="{DynamicResource L10n.VBack}" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" AutomationId="PageBackButton" />
                <Label Text="{DynamicResource L10n.VImportHeading}" Style="{StaticResource PageHeading}" />
                <Label Text="{DynamicResource L10n.VImportInstructions}" Style="{StaticResource MutedText}" />
                <Button Text="{DynamicResource L10n.VChooseFile}" Command="{Binding ChooseCommand}" />
                <Button Text="{DynamicResource L10n.VExcelTemplate}" Command="{Binding TemplateCommand}" />
                <Label Text="{Binding SheetName}" FontAttributes="Bold" />
                <Label Text="{Binding Summary}" Style="{StaticResource SectionHeading}" />
                <Button Text="{DynamicResource L10n.VImportAction}" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </controls:CollectionWorkspace.Form>
        <controls:CollectionWorkspace.Collection>
            <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding RowNumber}" FontAttributes="Bold" />
                                <Label Text="{Binding Vietnamese}" MaxLines="3" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding English}" MaxLines="3" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Status}" Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </controls:CollectionWorkspace.Collection>
    </controls:CollectionWorkspace>
</ContentPage>
