<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.InteractionDialog"
             BackgroundColor="Transparent">
    <Grid x:Name="DialogHost" SizeChanged="OnDialogSizeChanged">
        <BoxView BackgroundColor="Transparent"
                 Color="{AppThemeBinding Light={StaticResource DialogBackdropLight}, Dark={StaticResource DialogBackdropDark}}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancelClicked" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="DialogSurface" Style="{StaticResource DialogSurface}"
                HorizontalOptions="Center" VerticalOptions="Center" AutomationId="InteractionDialog">
            <Grid x:Name="DialogLayout" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                <Label x:Name="DialogHeading" Style="{StaticResource SectionHeading}"
                       SemanticProperties.HeadingLevel="Level1" SizeChanged="OnDialogSizeChanged"
                       AutomationId="DialogTitle" />
                <BoxView Grid.Row="1" HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                <ScrollView x:Name="DialogScroll" Grid.Row="2" MaximumHeightRequest="320" VerticalScrollBarVisibility="Default">
                    <VerticalStackLayout x:Name="DialogBody" Spacing="12">
                        <Label x:Name="DialogMessage" IsVisible="False" AutomationId="DialogMessage" />
                        <Border x:Name="PromptField" IsVisible="False" StrokeShape="RoundRectangle 10" Padding="12,4"
                                Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}">
                            <controls:VocabularyEntry x:Name="PromptEntry" ReturnType="Done"
                                                      Completed="OnPromptCompleted" AutomationId="DialogInput" />
                        </Border>
                        <VerticalStackLayout x:Name="ActionList" Spacing="6" IsVisible="False" />
                        <VerticalStackLayout x:Name="DestructiveActions" Spacing="12" IsVisible="False">
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                            <Button x:Name="DestructiveButton" Style="{StaticResource DialogDangerButton}"
                                    Clicked="OnDestructiveClicked" AutomationId="DialogDestructiveButton" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                <Grid x:Name="DialogFooter" Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8"
                      SizeChanged="OnDialogSizeChanged">
                    <Button x:Name="CancelButton" Grid.ColumnSpan="2" Style="{StaticResource DialogCancelButton}"
                            Clicked="OnCancelClicked" AutomationId="DialogCancelButton" />
                    <Button x:Name="AcceptButton" Grid.Column="1" IsVisible="False"
                            Style="{StaticResource DialogActionButton}" Clicked="OnAcceptClicked"
                            AutomationId="DialogAcceptButton" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>
