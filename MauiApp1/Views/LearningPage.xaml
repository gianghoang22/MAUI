<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels" xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.LearningPage" x:DataType="vm:LearningViewModel" Title="{DynamicResource L10n.VLearn}" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="24">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Text="{DynamicResource L10n.VBack}" Command="{Binding ExitCommand}" Style="{StaticResource QuietButton}" AutomationId="StudyBackButton" />
            <Label Grid.Column="1" Text="{Binding DeckName}" Style="{StaticResource SectionHeading}" VerticalOptions="Center" MaxLines="2" LineBreakMode="TailTruncation" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24" MaximumWidthRequest="800" HorizontalOptions="Fill" Padding="4,4,4,28">
                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                    <Label Text="{DynamicResource L10n.VStudyFocus}" Style="{StaticResource Eyebrow}" Margin="0,8,16,8" />
                    <Button Text="{DynamicResource L10n.VCustomize}" Command="{Binding SetupCommand}" Style="{StaticResource QuietButton}"
                            IsEnabled="{Binding IsNotBusy}" AutomationId="StudySetupButton" x:Name="StudySetupButton" />
                </FlexLayout>
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowSetup}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{DynamicResource L10n.VStudySetup}" Style="{StaticResource SectionHeading}" />
                        <controls:AdaptiveColumns>
                            <VerticalStackLayout Spacing="6"><Label Text="{DynamicResource L10n.VChooseMode}" Style="{StaticResource MutedText}" /><Picker ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" AutomationId="StudyModePicker" /></VerticalStackLayout>
                            <VerticalStackLayout Spacing="6"><Label Text="{DynamicResource L10n.VChooseDirection}" Style="{StaticResource MutedText}" /><Picker ItemsSource="{Binding Directions}" SelectedIndex="{Binding DirectionIndex}" AutomationId="StudyDirectionPicker" /></VerticalStackLayout>
                            <VerticalStackLayout Spacing="6"><Label Text="{DynamicResource L10n.VStudyFilter}" Style="{StaticResource MutedText}" /><Picker ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex}" AutomationId="StudyFilterPicker" /></VerticalStackLayout>
                        </controls:AdaptiveColumns>
                        <Label Text="{Binding StudyFilterSummary}" Style="{StaticResource MutedText}" />
                        <Label Text="{DynamicResource L10n.VPendingStudyFilterHint}" Style="{StaticResource MutedText}" />
                        <VerticalStackLayout Spacing="8" IsEnabled="{Binding IsNotBusy}">
                            <Button Text="{DynamicResource L10n.VUseAllCards}" Command="{Binding ResetStudyFilterCommand}" Style="{StaticResource QuietButton}" />
                            <Button Text="{DynamicResource L10n.VApplySetup}" Command="{Binding ApplySetupCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasEligibleCards}" AutomationId="ApplyStudySetupButton" />
                            <Button Text="{DynamicResource L10n.Cancel}" Command="{Binding CancelSetupCommand}" Style="{StaticResource QuietButton}" AutomationId="CancelStudySetupButton" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource InsetCard}" Padding="20">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                        <Label Text="{Binding ModeName}" Style="{StaticResource SectionHeading}" />
                        <Label Grid.Column="1" Text="{Binding Position}" Style="{StaticResource Eyebrow}" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DirectionName}" Style="{StaticResource MutedText}" />
                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Progress="{Binding Progress}" SemanticProperties.Description="{Binding Position}" />
                    </Grid>
                </Border>
                <VerticalStackLayout Spacing="16" IsVisible="{Binding ShowQuestion}">
                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="End" Margin="-4,0" IsEnabled="{Binding IsNotBusy}">
                        <Button Text="{DynamicResource L10n.VSpeak}" Command="{Binding SpeakCommand}" Style="{StaticResource QuietButton}" Margin="4" AutomationId="SpeakButton" />
                        <Button Text="{Binding StarDescription}" Command="{Binding StarCommand}" Style="{StaticResource QuietButton}" Margin="4" AutomationId="StudyStarButton" />
                    </FlexLayout>
                    <controls:VocabularyFlashcard Prompt="{Binding QuestionText}" Answer="{Binding AnswerText}" IsRevealed="{Binding ShowAnswer}"
                                                  IsTwoSided="{Binding IsFlashcard}" FlipCommand="{Binding FlipCommand}" FrontCaption="{Binding FrontCaption}" BackCaption="{Binding BackCaption}" />
                    <Label Text="{DynamicResource L10n.VAnswerHint}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" IsVisible="{Binding ShowFlip}" />
                    <Button Text="{DynamicResource L10n.VFlip}" Command="{Binding FlipCommand}" IsVisible="{Binding ShowFlip}" IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryButton}" AutomationId="FlipCardButton" x:Name="FlipCardButton" />
                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Center" IsVisible="{Binding ShowRating}" IsEnabled="{Binding IsNotBusy}" Margin="-4,0">
                        <Button Text="{DynamicResource L10n.VForget}" Command="{Binding ForgetCommand}" Style="{StaticResource QuietButton}" Margin="4" AutomationId="ForgetButton" />
                        <Button Text="{DynamicResource L10n.VRemember}" Command="{Binding RememberCommand}" Style="{StaticResource PrimaryButton}" Margin="4" AutomationId="RememberButton" />
                    </FlexLayout>
                    <controls:AdaptiveColumns x:Name="ChoiceList" BindableLayout.ItemsSource="{Binding Choices}" BindableLayout.ItemTemplate="{StaticResource ChoiceTemplate}" IsVisible="{Binding ShowChoices}" />
                    <VerticalStackLayout Spacing="16" IsVisible="{Binding ShowWritten}">
                        <Entry IsReadOnly="{Binding IsBusy}" Text="{Binding Input}" Placeholder="{DynamicResource L10n.VTypeAnswer}" MaxLength="200" ReturnCommand="{Binding SubmitCommand}" ReturnType="Done" AutomationId="WrittenAnswerEntry" x:Name="WrittenAnswerEntry" />
                        <Button Text="{DynamicResource L10n.VCheckAnswer}" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsNotBusy}" AutomationId="CheckAnswerButton" />
                    </VerticalStackLayout>
                    <Label Text="{Binding Feedback}" IsVisible="{Binding ShowNext}" FontSize="20" FontAttributes="Bold" />
                    <Button Text="{DynamicResource L10n.VNext}" Command="{Binding NextCommand}" IsVisible="{Binding ShowNext}" IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryButton}" AutomationId="NextQuestionButton" x:Name="NextQuestionButton" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding ShowMatch}" Spacing="16">
                    <Label Text="{Binding MatchFeedback}" Style="{StaticResource SectionHeading}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MatchLeft}" BindableLayout.ItemTemplate="{StaticResource MatchTemplate}" Spacing="16" />
                        <VerticalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding MatchRight}" BindableLayout.ItemTemplate="{StaticResource MatchTemplate}" Spacing="16" />
                    </Grid>
                </VerticalStackLayout>
                <Border Style="{StaticResource InsetCard}" IsVisible="{Binding ShowResult}">
                    <VerticalStackLayout Spacing="20" Padding="4">
                        <Label Text="{DynamicResource L10n.VSessionComplete}" Style="{StaticResource SectionHeading}" />
                        <Label Text="{Binding Score}" FontSize="32" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
                        <Label Text="{Binding ResultDetails}" Style="{StaticResource MutedText}" />
                        <FlexLayout Wrap="Wrap" Direction="Row" Margin="-4,0" IsEnabled="{Binding IsNotBusy}">
                            <Button Text="{DynamicResource L10n.VContinueLearning}" Command="{Binding ContinueCommand}" IsVisible="{Binding CanContinue}" Margin="4" Style="{StaticResource PrimaryButton}" AutomationId="ContinueLearningButton" />
                            <Button Text="{DynamicResource L10n.VRetryWrong}" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" Margin="4" AutomationId="RetryWrongButton" />
                            <Button Text="{DynamicResource L10n.VBackToDeck}" Command="{Binding ExitCommand}" Margin="4" Style="{StaticResource QuietButton}" AutomationId="BackToDeckButton" />
                        </FlexLayout>
                        <Border Style="{StaticResource Card}" BackgroundColor="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" IsVisible="{Binding CanRetry}" Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{DynamicResource L10n.VRetryWrong}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                <Label Text="{Binding WrongAnswers}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="{DynamicResource L10n.VNoFilteredCards}" IsVisible="{Binding NoRemainingCards}" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding SaveStatus}" Style="{StaticResource MutedText}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
