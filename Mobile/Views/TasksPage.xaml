<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiBasics.ViewModels"
             x:Class="MauiBasics.Views.TasksPage" x:DataType="vm:TasksViewModel"
             Title="Việc nhỏ" SafeAreaEdges="All">
  <!-- CollectionView là vùng cuộn duy nhất; header và việc cùng cuộn khi chữ lớn. -->
  <CollectionView ItemsSource="{Binding Items}" SelectionMode="None"
                  MaximumWidthRequest="640" HorizontalOptions="Fill"
                  ItemSizingStrategy="MeasureAllItems">
    <CollectionView.Header>
      <VerticalStackLayout Padding="24,24,24,16" Spacing="20">
        <VerticalStackLayout Spacing="6">
          <Label Text="MỘT CHÚT MỖI NGÀY" Style="{StaticResource MutedLabel}" CharacterSpacing="2" />
          <Label Text="Việc nhỏ." FontSize="36" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
          <Label Text="Bắt đầu từ một điều đơn giản." Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Tint}, Dark={StaticResource TintDark}}">
          <VerticalStackLayout Spacing="6">
            <Label Text="Từng bước một" FontSize="20" FontAttributes="Bold" />
            <Label Text="{Binding Summary}" AutomationId="TaskSummary" />
          </VerticalStackLayout>
        </Border>
        <VerticalStackLayout Spacing="8">
          <Label Text="Việc bạn muốn làm" Style="{StaticResource SectionTitle}" />
          <Border Padding="12,0" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}">
            <Entry x:Name="TaskTitleEntry" Text="{Binding NewTitle, Mode=TwoWay}"
                   Placeholder="Ví dụ: Đọc 10 trang sách" MaxLength="100"
                   IsEnabled="{Binding CanEdit}" ReturnType="Done" ReturnCommand="{Binding AddCommand}"
                   SemanticProperties.Hint="Tên việc bạn muốn làm, tối đa 100 ký tự rồi bấm Thêm việc"
                   AutomationId="NewTaskEntry" />
          </Border>
          <Label Text="Tối đa 100 ký tự. Lưu tự động, dùng được ngoại tuyến." Style="{StaticResource MutedLabel}" />
          <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                 TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                 AutomationId="TaskError" />
          <Button Text="Thêm việc" Command="{Binding AddCommand}" AutomationId="AddTaskButton" />
          <Button Text="Thử tải lại" Command="{Binding RetryCommand}" IsVisible="{Binding NeedsReload}"
                  Style="{StaticResource SecondaryButton}" />
          <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                             Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                             SemanticProperties.Description="Đang xử lý công việc" />
          <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>
        <Label Text="Danh sách của bạn" Style="{StaticResource SectionTitle}" />
      </VerticalStackLayout>
    </CollectionView.Header>
    <CollectionView.EmptyView>
      <VerticalStackLayout Padding="24,8,24,32" Spacing="8">
        <Label Text="Một khởi đầu nhẹ nhàng" FontAttributes="Bold" FontSize="20" />
        <Label Text="Chưa có việc nào. Thêm điều đầu tiên bạn muốn hoàn thành hôm nay." Style="{StaticResource MutedLabel}" />
      </VerticalStackLayout>
    </CollectionView.EmptyView>
    <CollectionView.ItemTemplate>
      <DataTemplate x:DataType="vm:TaskRow">
        <Border Margin="24,0,24,12" Padding="16">
          <VerticalStackLayout Spacing="12">
            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold">
              <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                  <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
              </Label.Triggers>
            </Label>
            <Label Text="{Binding Status}" Style="{StaticResource MutedLabel}" />
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start">
              <Button Text="{Binding ToggleText}" Command="{Binding ToggleCommand}" CommandParameter="{Binding Id}"
                      Margin="0,0,8,8" Style="{StaticResource SecondaryButton}"
                      SemanticProperties.Description="{Binding ToggleDescription}" />
              <Button Text="Xóa" Clicked="OnDeleteClicked" Margin="0,0,0,8" Style="{StaticResource DeleteButton}"
                      SemanticProperties.Description="{Binding DeleteDescription}" />
            </FlexLayout>
          </VerticalStackLayout>
        </Border>
      </DataTemplate>
    </CollectionView.ItemTemplate>
    <CollectionView.Footer><BoxView HeightRequest="16" Color="Transparent" /></CollectionView.Footer>
  </CollectionView>
</ContentPage>
